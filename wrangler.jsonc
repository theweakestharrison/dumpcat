// Cloudflare Worker that serves the landing page in site/ at https://dumpcat.cc (static assets only, no code).
// Deploy with `npx wrangler deploy`; see docs/website.vi.md. site/_headers sets the security headers.
{
  "name": "dumpcat-site",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./site",
    // a missing path gets site/404.html (written by scripts/build-site.py) with status 404
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "dumpcat.cc", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}

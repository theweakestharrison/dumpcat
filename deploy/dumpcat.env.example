# /etc/dumpcat/dumpcat.env — DumpCat configuration (KEY=VALUE, systemd EnvironmentFile)
# Windows: C:\ProgramData\DumpCat\dumpcat.env (written by install.ps1), data in C:\ProgramData\DumpCat\data

# Address to listen on. Use 127.0.0.1:6369 when behind nginx/caddy.
DUMPCAT_LISTEN=0.0.0.0:6369

# Data directory: database, master key, logs, staging area.
DUMPCAT_DATA_DIR=/var/lib/dumpcat

# Public URL (links in notifications, OAuth callback). Can also be set in the UI.
#DUMPCAT_BASE_URL=https://backup.example.com

# HTTPS directly (choose one):
#DUMPCAT_TLS_AUTO=1                       # self-signed certificate in DATA_DIR/tls
#DUMPCAT_TLS_CERT=/etc/dumpcat/tls/fullchain.pem
#DUMPCAT_TLS_KEY=/etc/dumpcat/tls/privkey.pem

# Set to 1 when running behind a reverse proxy (uses X-Forwarded-For/Proto).
#DUMPCAT_TRUST_PROXY=1

# Optional: master key (base64, 32 bytes) instead of DATA_DIR/master.key.
# Generate: head -c32 /dev/urandom | base64
#DUMPCAT_MASTER_KEY=

# Extra directories to search for mysqldump/mydumper/xtrabackup/rclone (':' separated, ';' on Windows).
#DUMPCAT_TOOLS_DIR=/opt/percona-xtrabackup-8.4/bin

# Log every HTTP request (debug).
#DUMPCAT_ACCESS_LOG=1

# Also write the application log to a file, rotated at 20 MB (5 files kept).
# A Windows service always logs to DATA_DIR\dumpcat.log unless this is set.
#DUMPCAT_LOG_FILE=/var/log/dumpcat/dumpcat.log

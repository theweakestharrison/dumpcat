# DumpCat agent configuration (/etc/dumpcat/agent.env, Windows: %ProgramData%\DumpCat\agent.env)
# The agent runs on a database host that accepts no inbound connections: it
# connects out to the DumpCat server and opens the database connections the
# server asks for. Keep this file readable by root only (it holds the key).
# After editing: systemctl restart dumpcat-agent (Windows: Restart-Service DumpCatAgent)

# DumpCat address as this host reaches it (the agent uses HTTPS or HTTP, port of the web UI)
DUMPCAT_AGENT_SERVER=https://backup.example.com

# key from the Agents page of the web UI (shown once; "Rotate key" issues a new one)
DUMPCAT_AGENT_KEY=dca_...

# database addresses the server may ask for, comma separated: host:port or unix:/path
# (default: 127.0.0.1:3306, [::1]:3306 and the usual MySQL/MariaDB sockets; * = any address)
#DUMPCAT_AGENT_ALLOW=127.0.0.1:3306,unix:/var/run/mysqld/mysqld.sock

# accept a self-signed certificate on the server without verifying it
#DUMPCAT_AGENT_INSECURE=1

# physical backups: DumpCat may run mariabackup/xtrabackup on this host and stream the
# backup back (database credentials are sent with each backup, never stored here).
# The agent must be able to read the datadir: install.sh --allow-physical runs it as
# the datadir's owner (a systemd drop-in); the Windows service runs as LocalSystem.
#DUMPCAT_AGENT_ALLOW_PHYSICAL=1
# datadir the Agents page reports as readable or not (default: /var/lib/mysql or the
# usual location; each backup checks the server's own @@datadir)
#DUMPCAT_AGENT_DATADIR=/var/lib/mysql

# also write the log to this file when the agent runs by hand (the systemd service
# logs to the journal: journalctl -u dumpcat-agent; the Windows service to
# %ProgramData%\DumpCat\agent.log)
#DUMPCAT_AGENT_LOG=/var/tmp/dumpcat-agent.log
